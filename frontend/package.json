{
  "name": "open-msupply-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "concurrently -k -n vite,css-types,plugin-css-types -c auto \"vite\" \"tcm --watch --pattern '**/*.module.css' src\" \"tcm --watch --pattern '*/src/**/*.module.css' plugins\"",
    "build": "pnpm css:types && tsc -b && vite build",
    "build:showcase": "pnpm css:types && tsc -b && vite build --config vite.showcase.config.ts",
    "build:plugins": "node scripts/build-plugins.mjs",
    "electron": "pnpm build && electron desktop/main.cjs",
    "electron:package": "pnpm build && bash scripts/package-desktop.sh",
    "preview": "vite preview",
    "preview:showcase": "vite preview --config vite.showcase.config.ts",
    "build:prototypes": "pnpm css:types && tsc -b && vite build --config vite.prototypes.config.ts",
    "preview:prototypes": "vite preview --config vite.prototypes.config.ts",
    "css:types": "tcm --pattern '**/*.module.css' src && tcm --pattern '*/src/**/*.module.css' plugins",
    "check": "pnpm css:types && tsc -b && stylelint \"src/**/*.css\" \"plugins/*/src/**/*.css\" \"plugins/examples/**/*.css\" && node scripts/check-theme-tokens.mjs && node scripts/check-page-css.mjs && node scripts/check-reduced-motion.mjs && node scripts/check-min-browser.mjs && node --no-warnings=ExperimentalWarning scripts/check-test-runners.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codegen": "node codegen/run.cjs",
    "generate": "cd ../server && cargo run --bin remote_server_cli -- export-graphql-schema --path ../frontend/spec/schema.graphql && cd ../frontend && pnpm codegen",
    "translate-locale": "node scripts/translate-locale.mjs",
    "test": "vitest run",
    "test:codegen": "node --test \"codegen/__tests__/*.test.cjs\"",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:local": "bash scripts/e2e/run-e2e.sh",
    "dev-android": "./scripts/dev-android.sh",
    "worktree": "./scripts/worktree.sh",
    "build-android": "./scripts/build-android.sh",
    "brief": "python3 exploratory/tools/behaviour_brief.py",
    "check:anchors": "python3 exploratory/tools/check_anchor_refs.py"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@corvu/calendar": "^0.1.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@kobalte/core": "^0.13.12",
    "@solid-primitives/i18n": "^2.2.1",
    "@solidjs/router": "^0.15.3",
    "@tanstack/solid-table": "^8.21.3",
    "date-fns": "^4.4.0",
    "solid-js": "^1.9.13",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/core": "^6.2.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "concurrently": "^9.2.3",
    "electron": "^44.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-comment-length": "^2.3.1",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.7.0",
    "graphql": "^16.10.0",
    "prettier": "3.9.5",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typed-css-modules": "^0.9.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.1",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "browserslist": [
    "chrome >= 132"
  ]
}
