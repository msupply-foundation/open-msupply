{
  "name": "open-msupply-frontend",
  "private": true,
  "version": "3.00.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "concurrently -k -n vite,css-types -c auto \"vite\" \"tcm --watch --pattern '**/*.module.css' src\"",
    "build": "tcm --pattern '**/*.module.css' src && tsc -b && vite build",
    "build:showcase": "tcm --pattern '**/*.module.css' src && tsc -b && vite build --config vite.showcase.config.ts",
    "preview": "vite preview",
    "preview:showcase": "vite preview --config vite.showcase.config.ts",
    "css:types": "tcm --pattern '**/*.module.css' src",
    "check": "tcm --pattern '**/*.module.css' src && tsc -b && stylelint \"src/**/*.css\" && node scripts/check-theme-tokens.mjs && node scripts/check-page-css.mjs && node scripts/check-min-browser.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codegen": "node codegen/run.cjs",
    "test": "vitest run",
    "test:codegen": "node --test \"codegen/__tests__/*.test.cjs\"",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:local": "bash scripts/e2e/run-e2e.sh",
    "dev-android": "./scripts/dev-android.sh",
    "build-android": "./scripts/build-android.sh",
    "brief": "python3 exploratory/tools/behaviour_brief.py",
    "check:anchors": "python3 exploratory/tools/check_anchor_refs.py"
  },
  "dependencies": {
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.4.1",
    "@corvu/calendar": "^0.1.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@kobalte/core": "^0.13.12",
    "@solid-primitives/i18n": "^2.2.1",
    "@solidjs/router": "^0.15.3",
    "@tanstack/solid-table": "^8.21.3",
    "date-fns": "^4.4.0",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/core": "^6.2.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "concurrently": "^9.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-comment-length": "^2.3.1",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.7.0",
    "graphql": "^16.10.0",
    "prettier": "3.9.5",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typed-css-modules": "^0.9.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.1",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "browserslist": [
    "chrome >= 138"
  ]
}
