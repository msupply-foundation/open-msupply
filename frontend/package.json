{
  "name": "open-msupply-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "concurrently -k -n vite,css-types -c auto \"vite\" \"tcm --watch --pattern '**/*.module.css' src\"",
    "build": "tcm --pattern '**/*.module.css' src && tsc -b && vite build",
    "preview": "vite preview",
    "css:types": "tcm --pattern '**/*.module.css' src",
    "check": "tcm --pattern '**/*.module.css' src && tsc -b && stylelint \"src/**/*.css\" && node scripts/check-theme-tokens.mjs && node scripts/check-page-css.mjs",
    "codegen": "node codegen/run.js",
    "test": "vitest run",
    "test:codegen": "node --test \"codegen/__tests__/*.test.js\"",
    "dev-android": "./scripts/dev-android.sh",
    "build-android": "./scripts/build-android.sh"
  },
  "dependencies": {
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.4.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@kobalte/core": "^0.13.12",
    "@solid-primitives/i18n": "^2.2.1",
    "@solidjs/router": "^0.15.3",
    "@tanstack/solid-table": "^8.21.3",
    "date-fns": "^4.4.0",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@graphql-codegen/cli": "^5.0.3",
    "@types/node": "^24.13.2",
    "concurrently": "^9.2.3",
    "graphql": "^16.10.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typed-css-modules": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
