# Generated CSS type declarations (regenerated by `npm run css:types`) — both CSS-module
# (*.module.css.d.ts) and global stylesheets (index.css, tokens.css → *.css.d.ts).
*.css.d.ts

# Playwright MCP session artifacts (page snapshots, console logs)
.playwright-mcp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
/.playwright-mcp

# Playwright output (deterministic e2e suites in e2e/)
e2e/test-results
e2e/playwright-report

# Local git worktrees (multi-worktree dev flow)
/.worktrees/

# Deploy bookkeeping, written by deploy/build-and-deploy.sh into the server's
# build checkout (untracked so `git reset --hard` in the poller leaves it be)
/.deploy-state
/.deploy-last-success

# Per-developer Claude Code notes
CLAUDE.local.md
__pycache__/
