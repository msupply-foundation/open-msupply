# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Generated CSS type declarations (regenerated by `npm run css:types`) — both CSS-module
# (*.module.css.d.ts) and global stylesheets (index.css, tokens.css → *.css.d.ts).
*.css.d.ts

# Playwright MCP session artifacts (page snapshots, console logs)
.playwright-mcp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
/.playwright-mcp

# Playwright output (deterministic e2e suites in e2e/)
e2e/test-results
e2e/playwright-report

# Spec-owned verticals are regenerated from spec/ (spec-build) and stay out of
# git — only the reference vertical (stocktakes) and sync-modal are tracked.
src/sections/*
!src/sections/stocktakes/
!src/sections/sync-modal/
