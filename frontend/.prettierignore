# Prettier ignores. Prettier already skips node_modules and reads this file for
# everything else; it does NOT read .gitignore, so build output is listed here too.

# Dependencies & build output
node_modules
dist
dist-ssr

# Generated — regenerated by codegen / typed-css-modules, never hand-edited
*.generated.ts
*.css.d.ts

# Generated — refreshed wholesale from backend introspection, never hand-edited;
# formatting it would be undone by the next refresh
spec/schema.graphql

# Codegen tooling: CommonJS, plus expected-output fixtures the codegen tests
# compare byte-for-byte against the (non-Prettier) generator output.
codegen

# CIV's backend half. It builds and type-checks here, but the source arrived
# from msupply-foundation/civ-plugins formatted to that repo's conventions;
# #417 carries reformatting it (see plugins/civ/backend/README.md). Named
# rather than globbed as plugins/*/backend, to match eslint.config.js: the
# backend halves written HERE — the reference plugin (examples/*/backend) and
# plugins/cook_islands/backend — are ours outright and ARE formatted.
plugins/civ/backend

# A prebuilt bundle is a build artifact wherever it appears.
plugins/*/backend/prebuilt

# Lockfile
pnpm-lock.yaml
