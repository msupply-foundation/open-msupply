# Prettier ignores. Prettier already skips node_modules and reads this file for
# everything else; it does NOT read .gitignore, so build output is listed here too.

# Dependencies & build output
node_modules
dist
dist-ssr

# Generated — regenerated by codegen / typed-css-modules, never hand-edited
*.generated.ts
*.css.d.ts

# Generated — refreshed wholesale from backend introspection, never hand-edited;
# formatting it would be undone by the next refresh
spec/schema.graphql

# Codegen tooling: CommonJS, plus expected-output fixtures the codegen tests
# compare byte-for-byte against the (non-Prettier) generator output.
codegen

# A prebuilt bundle is a build artifact wherever it appears — a committed
# build is packed verbatim, so reformatting it would change what ships.
plugins/*/backend/prebuilt

# Lockfile
pnpm-lock.yaml
