{
  /*
   * The in-repo plugins — the reference plugins (examples/*) and the country
   * plugins (plugins/*) — typechecked exactly as an out-of-tree plugin would
   * be: the SDK resolved from source through the `@openmsupply/plugin-sdk`
   * path mapping (what civ-plugins does with a submodule/sibling checkout),
   * and NO `@/*` mapping — a plugin reaching into host source must not
   * compile. Compiler options mirror tsconfig.app.json so a plugin sees the
   * host's strictness and JSX runtime.
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.plugins.tsbuildinfo",
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "paths": { "@openmsupply/plugin-sdk": ["./src/plugin-sdk/index.ts"] },
    "allowImportingTsExtensions": true,
    // One divergence from tsconfig.app.json: a plugin imports its identity
    // (name, version) from its own package.json — the same file the pack step
    // and the server's install gate read — instead of restating it as
    // literals that can drift.
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /*
   * The globals the SDK's own graph relies on (Vite `define` injections). They
   * are ambient declarations, so they must be listed: `include` here is
   * plugins-only, and the SDK arrives through the path mapping rather than
   * through the file list.
   */
  "include": [
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "plugins/*/src/**/*.ts",
    "plugins/*/src/**/*.tsx",
    // cook_islands' BACKEND half, plus the `shared/` wire contract both
    // halves import. Named rather than globbed as `plugins/*/backend`,
    // because civ's half compiles only against its own toolchain's
    // `@common/*` and so must stay out.
    "plugins/cook_islands/backend/src/**/*.ts",
    "plugins/cook_islands/shared/**/*.ts",
    "src/globals.d.ts",
    "src/intl/globals.d.ts"
  ]
}
