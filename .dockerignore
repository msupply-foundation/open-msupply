# The server is compiled inside the image now, so no host build output should
# enter the context. These rules previously did the opposite - they let the
# prebuilt release binaries through, because the image only assembled them.
server/target
server/target-*

# Node
node_modules
**/node_modules

# Build output - regenerated by the build stages
frontend/dist
client/packages/*/dist

# Android/Electron BUILD output only. The packages themselves must stay: the
# root package.json globs `client/packages/*` as yarn workspaces, so omitting
# them changes resolution and `yarn install --immutable` refuses to run.
client/packages/android/app/build
client/packages/android/.gradle
client/packages/android/honeywell-android-data-collection-sdk
client/packages/android/doc
client/packages/electron/out

.git
.github
docs
