{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Control",
      "scope": "#/properties/transactionType",
      "label": "T#report.transaction-type",
      "options": {
        "show": [
          ["OUTBOUND_SHIPMENT", "T#report.sales-to-customers"],
          ["INBOUND_SHIPMENT", "T#report.purchases-from-suppliers"],
          ["PRESCRIPTION", "T#report.dispensing-to-patients"],
          ["CUSTOMER_RETURN", "T#report.returns-from-customers"],
          ["SUPPLIER_RETURN", "T#report.returns-to-suppliers"]
        ]
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/dateBasis",
      "label": "T#report.date-basis",
      "options": {
        "show": [
          ["CONFIRMED", "T#report.confirmed-date"],
          ["SHIPPED", "T#report.shipped-date"]
        ]
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/after",
      "label": "T#label.from-date",
      "options": {
        "dateOnly": true,
        "disableFuture": true,
        "max": "#/properties/before"
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/before",
      "label": "T#label.to-date",
      "options": {
        "dateOnly": true,
        "disableFuture": true,
        "min": "#/properties/after",
        "dateAsEndOfDay": true
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/stockTransfers",
      "label": "T#report.stock-transfers",
      "options": {
        "show": [
          ["INCLUDE", "T#report.include-stock-transfers"],
          ["EXCLUDE", "T#report.exclude-stock-transfers"],
          ["ONLY", "T#report.only-stock-transfers"]
        ]
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/nameSearch",
      "label": "T#report.name-search"
    },
    {
      "type": "Control",
      "scope": "#/properties/donorSearch",
      "label": "T#report.donor-search"
    },
    {
      "type": "Control",
      "scope": "#/properties/itemSearch",
      "label": "T#report.item-search"
    },
    {
      "type": "Control",
      "scope": "#/properties/itemCategory",
      "label": "T#report.item-category"
    },
    {
      "type": "MasterListSearch",
      "scope": "#/properties/masterListId",
      "label": "T#label.master-list"
    }
  ]
}
