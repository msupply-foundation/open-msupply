{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Filters": {
      "properties": {
        "transactionType": {
          "description": "Transaction type",
          "type": "string",
          "enum": [
            "OUTBOUND_SHIPMENT",
            "INBOUND_SHIPMENT",
            "PRESCRIPTION",
            "CUSTOMER_RETURN",
            "SUPPLIER_RETURN"
          ],
          "default": "OUTBOUND_SHIPMENT"
        },
        "dateBasis": {
          "description": "Which date the date range applies to",
          "type": "string",
          "enum": ["CONFIRMED", "SHIPPED"],
          "default": "CONFIRMED"
        },
        "after": {
          "description": "From date",
          "type": ["string", "null"],
          "format": "date-time",
          "default": null
        },
        "before": {
          "description": "To date",
          "type": ["string", "null"],
          "format": "date-time",
          "default": null
        },
        "stockTransfers": {
          "description": "Whether to include stock transfers between stores",
          "type": "string",
          "enum": ["INCLUDE", "EXCLUDE", "ONLY"],
          "default": "INCLUDE"
        },
        "nameSearch": {
          "description": "Customer or supplier code or name",
          "type": ["string", "null"],
          "default": null
        },
        "donorSearch": {
          "description": "Donor code or name",
          "type": ["string", "null"],
          "default": null
        },
        "itemSearch": {
          "description": "Item code or name",
          "type": ["string", "null"],
          "default": null
        },
        "itemCategory": {
          "description": "Item category",
          "type": ["string", "null"],
          "default": null
        },
        "masterListId": {
          "description": "Master list",
          "type": ["string", "null"],
          "default": null
        }
      },
      "required": ["transactionType", "dateBasis", "stockTransfers"]
    }
  },
  "type": "object",
  "allOf": [
    {
      "$ref": "#/definitions/Filters"
    }
  ]
}
